---
const stats = [
    { value: "100+", label: "sprzedanych maszyn" },
    { value: "500+", label: "zadowolonych klientów" },
    { value: "5+", label: "sprzedanych maszyn" },
    { value: "10+", label: "sprzedanych maszyn" },
    { value: "20+", label: "sprzedanych maszyn" }
];
---
<section class="bg-white">
    <div class="w-full bg-primary py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-6 md:px-12">
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 text-center text-white">
                {stats.map((stat) => (
                        <div class="flex flex-col items-center">
                            <span class="text-4xl md:text-5xl font-extrabold mb-2">{stat.value}</span>
                            <span class="text-sm md:text-base font-medium opacity-90">{stat.label}</span>
                        </div>
                ))}
            </div>
        </div>
    </div>
</section>
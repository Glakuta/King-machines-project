---
import Layout from '../../layouts/Layout.astro';
import MachineHero from '../../components/machines/MachineHero.astro';
import { mockMachines } from '../../lib/mockData';
import type { Machine } from '../../types/wp';

export function getStaticPaths() {
  return mockMachines.map((machine) => ({
    params: { slug: machine.slug },
    props: { machine },
  }));
}

interface Props {
  machine: Machine;
}

const { machine } = Astro.props;
const related = mockMachines.filter(
  (m) => m.category === machine.category && m.id !== machine.id
).slice(0, 3);
const images = machine.images?.length
  ? machine.images
  : ['https://placehold.co/800x500?text=King+Machines'];
---

<Layout title={`${machine.name} | King Machines`} description={machine.shortDescription}>
  <MachineHero machine={machine} />

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 space-y-12">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Galeria</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {images.map((src) => (
              <img
                src={src}
                alt={machine.name}
                class="w-full h-64 object-cover rounded-xl"
                loading="lazy"
              />
            ))}
          </div>
        </div>

        {machine.specifications && (
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Specyfikacja techniczna</h2>
            <dl class="divide-y divide-gray-200 border border-gray-200 rounded-xl overflow-hidden">
              {Object.entries(machine.specifications).map(([key, value]) => (
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 px-6 py-4 bg-gray-50 even:bg-white">
                  <dt class="font-medium text-gray-900">{key}</dt>
                  <dd class="sm:col-span-2 text-gray-600">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {machine.description && (
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Opis maszyny</h2>
            <div class="prose prose-lg max-w-none text-gray-600" set:html={machine.description} />
          </div>
        )}
      </div>

      <aside>
        <div class="bg-gray-50 p-6 rounded-xl">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Potrzebujesz więcej informacji?</h3>
          <p class="text-gray-600 mb-4">Skontaktuj się z nami – przygotujemy ofertę dopasowaną do Twojej produkcji.</p>
          <a href="/kontakt" class="block w-full bg-blue-600 text-white py-3 px-6 rounded-lg text-center font-medium hover:bg-blue-700 transition-colors">Skontaktuj się</a>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Powiązane maszyny</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {related.map((m) => (
            <a href={`/maszyny/${m.slug}`} class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <img
                src={m.images?.[0] || 'https://placehold.co/400x260?text=King+Machines'}
                alt={m.name}
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <span class="text-xs font-medium text-blue-600">{m.category}</span>
                <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">{m.name}</h3>
                {m.shortDescription && <p class="mt-2 text-sm text-gray-600">{m.shortDescription}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

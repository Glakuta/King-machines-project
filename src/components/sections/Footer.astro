---
// src/components/Footer.astro

const footerLinks = [
    {
        title: "Empresa",
        links: ["Sobre Nosotros", "Soluciones", "Insights"]
    },
    {
        title: "Categorías",
        links: ["Contratar Talento", "Desarrollar Talento", "Herramientas de Gamificación"]
    },
    {
        title: "",
        links: ["Competencias Digitales", "Competencias Comerciales", "Liderazgo"]
    }
];

const socialLinks = [
    { name: "Twitter", href: "#", icon: "M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z" },
    { name: "LinkedIn", href: "#", icon: "M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 2a2 2 0 100 4 2 2 0 000-4z" },
    { name: "Facebook", href: "#", icon: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" }
];

const legalLinks = ["Política de Privacidad", "Términos y Condiciones", "Código de Conducta"];
---

<footer class="w-full bg-primary pt-20 pb-10">
    <div class="max-w-7xl mx-auto px-6 md:px-12">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">

            <div class="flex flex-col items-start lg:col-span-1">
                <a href="/" class="block border-4 border-white p-2 text-white font-extrabold text-4xl tracking-widest leading-none">
                    LFT
                </a>
            </div>

            {footerLinks.map((column) => (
                    <div class="flex flex-col gap-6">
                        {column.title && (
                                <h3 class="text-white font-bold text-lg">
                                    {column.title}
                                </h3>
                        )}
                        <ul class:list={["flex flex-col gap-4", !column.title && "md:mt-10"]}>
                            {column.links.map((link) => (
                                    <li>
                                        <a href="#" class="text-white/80 hover:text-white transition-colors text-sm font-medium">
                                            {link}
                                        </a>
                                    </li>
                            ))}
                        </ul>
                    </div>
            ))}

        </div>

        <div class="w-full h-px bg-white/20 mb-8"></div>

        <div class="flex flex-col md:flex-row items-center justify-between gap-6">

            <div class="flex items-center gap-6">
                {socialLinks.map((social) => (
                        <a href={social.href} aria-label={social.name} class="text-white hover:text-[#0F2E24] transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d={social.icon} />
                            </svg>
                        </a>
                ))}
            </div>

            <div class="flex flex-wrap justify-center gap-6 md:gap-8">
                {legalLinks.map((link) => (
                        <a href="#" class="text-white/80 hover:text-white transition-colors text-xs md:text-sm font-medium">
                            {link}
                        </a>
                ))}
            </div>

        </div>

    </div>
</footer>
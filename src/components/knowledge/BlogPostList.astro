---
interface BlogArticle {
    id: string | number;
    title: string;
    excerpt: string;
    imageUrl: string;
    url: string;
}

interface Props {
    articles: BlogArticle[];
    pageTitle?: string;
    pageDescription?: string;
}

const {
    articles,
    pageTitle = "Blog",
    pageDescription = "Blog o praktycznej stronie i ciekawostkach dotyczących obrabiarek powstał z myślą o przyszłych i obecnych Klientach naszej firmy, którzy szukają rzetelnych informacji na temat ich prawidłowej eksploatacji."
} = Astro.props;
---

<section class="section bg-white">
    <div class="container-main">

        {pageTitle && (
            <div class="mb-16">
                <h1 class="text-4xl md:text-5xl font-bold text-primary-dark mb-4 inline-block border-b-4 border-primary pb-2">
                    {pageTitle}
                </h1>
                <p class="text-muted text-base md:text-lg max-w-4xl mt-6">
                    {pageDescription}
                </p>
            </div>
        )}

        <div class="flex flex-col gap-16">
            {articles.map((article) => (
                    <article class="flex flex-col md:flex-row gap-8 lg:gap-12 items-start group">

                        <div class="w-full md:w-5/12 lg:w-1/2 shrink-0 overflow-hidden rounded-xl">
                            <a href={article.url} class="block">
                                <img
                                        src={article.imageUrl}
                                        alt={article.title}
                                        class="w-full h-auto aspect-[16/10] object-cover rounded-xl group-hover:scale-[1.03] transition-transform duration-500 ease-in-out"
                                        loading="lazy"
                                />
                            </a>
                        </div>

                        <div class="w-full md:w-7/12 lg:w-1/2 flex flex-col pt-2 md:pt-4">
                            <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-primary tracking-tight mb-4 group-hover:text-primary-dark transition-colors duration-200">
                                <a href={article.url}>
                                    {article.title}
                                </a>
                            </h2>

                            <p class="text-muted text-base md:text-lg leading-relaxed mb-8">
                                {article.excerpt}
                            </p>

                            <div class="mt-auto">
                                <a href={article.url} class="inline-flex items-center gap-4 font-semibold text-primary hover:text-primary-dark transition-colors group/link">
                                    <span className="text-lg">Czytaj więcej</span>
                                    <span class="flex items-center justify-center w-12 h-12 bg-primary text-white rounded-md group-hover/link:bg-primary-dark transition-colors shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </span>
                                </a>
                            </div>
                        </div>

                    </article>
            ))}
        </div>

    </div>
</section>
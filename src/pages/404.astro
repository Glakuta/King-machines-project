---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/common/Navigation.astro';
---

<Layout title="404 - Strona nie znaleziona | King Machines">
  <section class="relative w-full min-h-[90vh] flex items-center justify-center overflow-hidden bg-gray-900">
    <div class="absolute inset-0 w-full h-full">
      <img
        src="https://placehold.co/1920x1080/2a2a2a/666666?text=Zdjęcie+CNC+w+tle"
        alt="Maszyna CNC w trakcie pracy"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-transparent"></div>
      <div class="absolute inset-0 bg-black/40 md:hidden"></div>
    </div>

    <Navigation />

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 flex flex-col justify-center h-full pt-32 pb-16">
      <div class="max-w-2xl text-center md:text-left">
        <p class="text-primary font-extrabold text-7xl md:text-8xl lg:text-9xl leading-none tracking-tight mb-4">404</p>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] tracking-tight mb-6">
          Strona nie znaleziona
        </h1>

        <p class="text-lg md:text-xl text-gray-300 font-light leading-relaxed mb-10 max-w-xl mx-auto md:mx-0">
          Wygląda na to, że ta strona nie istnieje lub została przeniesiona.
          Wróć do strony głównej lub skontaktuj się z nami – pomożemy Ci znaleźć to, czego szukasz.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-6 justify-center md:justify-start">
          <a href="/" class="btn-primary w-full sm:w-auto text-lg px-8 py-4">
            Wróć do strony głównej
          </a>

          <a href="/kontakt" class="btn-secondary w-full sm:w-auto text-lg px-8 py-4">
            Skontaktuj się
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

# WordPress Headless CMS Configuration
# Copy this file to .env and fill in your values

# WordPress Site URL (without trailing slash)
WP_URL=https://your-wordpress-site.com

# WordPress Application Password (for authenticated requests)
# Generate at: WP Admin > Users > Profile > Application Passwords
WP_USERNAME=your_username
WP_APP_PASSWORD=your_application_password

# Optional: Custom post type slugs (if different from defaults)
# WP_MACHINES_POST_TYPE=machines
# WP_ARTICLES_POST_TYPE=posts
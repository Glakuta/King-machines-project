    { title: "Lorem ipsum", icon: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" },
    { title: "Lorem ipsum", icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" },
    { title: "Lorem ipsum", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
    { title: "Lorem ipsum", icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" },
    { title: "Lorem ipsum", icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" }
];
---

<section class="relative w-full py-24 md:py-32 overflow-hidden">

    <div class="absolute inset-0 z-0">
        <img
                src="https://placehold.co/1920x1080/e5e7eb/9ca3af?text=Zdjęcie+tła+-+pracownik+w+kasku"
                alt="Pracownik w kasku"
                class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-white/70"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12">

        <div class="text-center mb-16">
      <span class="text-primary font-bold tracking-widest uppercase text-sm mb-2 block">
        Gwarantujemy
      </span>
            <h2 class="text-4xl md:text-5xl font-extrabold text-[#0F2E24] tracking-tight">
                Kompleksową usługę
            </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
            {features.map((feature) => (
                    <div class="flex flex-col items-center">

                        <div class="bg-white p-6 w-full text-center shadow-sm mb-[-2rem] relative z-10">
                            <h3 class="text-lg md:text-xl font-bold text-[#0F2E24]">
                                {feature.title}
                            </h3>
                        </div>

                        <div class="w-24 h-24 bg-primary rounded-full flex items-center justify-center relative z-20 shadow-lg border-4 border-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#0F2E24]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
                            </svg>
                        </div>

                    </div>
            ))}
        </div>

    </div>
</section>
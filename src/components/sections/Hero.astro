---
import Navigation from "../common/Navigation.astro";
const title = "Maszyny do obróbki metalu";
const description = "Dostarczamy zaawansowane rozwiązania technologiczne dla przemysłu. Nasze maszyny CNC gwarantują precyzję, wydajność i niezawodność w każdych warunkach produkcyjnych.";
const phone = "+48 566 456 789";
const email = "kontakt@lft.pl";
---

<section class="relative w-full min-h-[90vh] flex items-center justify-center overflow-hidden bg-gray-900">
    <div class="absolute inset-0 w-full h-full">
        <img
                src="https://placehold.co/1920x1080/2a2a2a/666666?text=Zdjęcie+CNC+w+tle"
                alt="Maszyna CNC w trakcie pracy"
                class="w-full h-full object-cover object-center"
        />

        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-transparent"></div>

        <div class="absolute inset-0 bg-black/40 md:hidden"></div>
    </div>


    <Navigation />


    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 flex flex-col justify-center h-full pt-32 pb-16">

        <div class="max-w-2xl text-center md:text-left">
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-[1.1] tracking-tight mb-6">
                {title}
            </h1>


            <p class="text-lg md:text-xl text-gray-300 font-light leading-relaxed mb-10 max-w-xl mx-auto md:mx-0">
                {description}
            </p>

            <div class="flex flex-col sm:flex-row items-center gap-6 justify-center md:justify-start">

                <a href="#maszyny" class="btn-primary w-full sm:w-auto text-lg px-8 py-4">
                    Zobacz maszyny
                </a>

                <div class="flex flex-col gap-1 text-sm text-gray-400 font-medium">
                    <a href={`tel:${phone.replace(/\s/g, '')}`} class="hover:text-white transition-colors flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                        {phone}
                    </a>
                    <a href={`mailto:${email}`} class="hover:text-white transition-colors flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                        {email}
                    </a>
                </div>
            </div>
        </div>

    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 text-white/50">
        <span class="text-xs uppercase tracking-widest">Przewiń</span>
        <div class="w-[1px] h-8 bg-white/30"></div>
    </div>

</section>
---
import Layout from '../../layouts/Layout.astro';
import BlogPostList from '../../components/knowledge/BlogPostList.astro';
import { mockArticles, mockCategories } from '../../lib/mockData';

const articles = mockArticles.map((article) => ({
  id: article.id,
  title: article.title,
  excerpt: article.excerpt,
  imageUrl: article.image || 'https://placehold.co/800x500?text=King+Machines',
  url: `/baza-wiedzy/${article.slug}`,
}));
---

<Layout title="Baza Wiedzy | King Machines" description="Poradniki, porównania i case studies dotyczące maszyn pakujących i przemysłowych.">
  <section class="bg-gray-50 pt-32 pb-12">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">Baza Wiedzy</h1>
    </div>
  </section>

  <BlogPostList articles={articles} pageTitle="" pageDescription="" />
</Layout>
